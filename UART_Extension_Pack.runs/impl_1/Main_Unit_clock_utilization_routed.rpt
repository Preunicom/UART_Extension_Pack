# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y0 [get_cells spi_sck_OBUF_BUFG_inst]
set_property LOC BUFGCTRL_X0Y2 [get_cells prescale_factor_int_reg[7]_i_1]
set_property LOC BUFGCTRL_X0Y3 [get_cells last_serial_in_reg_i_1]
set_property LOC BUFGCTRL_X0Y4 [get_cells last_serial_in_reg_i_1__0]
set_property LOC BUFGCTRL_X0Y1 [get_cells clk_IBUF_BUFG_inst]

# Location of IO Primitives which is load of clock spine
set_property LOC IOB_X0Y34 [get_cells spi_sck_OBUF_inst]

# Location of clock ports
set_property LOC IOB_X0Y26 [get_ports clk]

# Clock net "spi_sck_OBUF_BUFG" driven by instance "spi_sck_OBUF_BUFG_inst" located at site "BUFGCTRL_X0Y0"
#startgroup
create_pblock {CLKAG_spi_sck_OBUF_BUFG}
add_cells_to_pblock [get_pblocks  {CLKAG_spi_sck_OBUF_BUFG}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL && NAME!=spi_sck_OBUF_inst} -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="spi_sck_OBUF_BUFG"}]]]
resize_pblock [get_pblocks {CLKAG_spi_sck_OBUF_BUFG}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0}
#endgroup

